# ---------------------------------------------------------------------------
# Consumed by docker compose only (compose.yml), not by the application.
# Do NOT copy this block into a local .env: Settings uses extra="forbid" and
# refuses to start on unknown variables.
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=docarag-root-user
MINIO_ROOT_PASSWORD=your-secure-password-here

# ---------------------------------------------------------------------------
# Application settings (src/docarag/settings.py). Required, no defaults.
# ---------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=docarag-root-user
MINIO_SECRET_KEY=your-secure-password-here
MINIO_BUCKET=default-documents

# ---------------------------------------------------------------------------
# Model providers. Each component is selected independently through env.
# Default: everything on OpenRouter with one shared key.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-your-openrouter-key
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen3.8-flash
# Disable reasoning output on thinking models (OpenRouter syntax); llama.cpp /
# vLLM Qwen3 use {"chat_template_kwargs": {"enable_thinking": false}}
# LLM_EXTRA_BODY={"reasoning": {"enabled": false}}
# LLM_DEFAULT_HEADERS={"HTTP-Referer": "https://example.com", "X-Title": "doc-arag"}
# LLM_TEMPERATURE=0.7
# LLM_TIMEOUT=120
# LLM_MAX_RETRIES=2
# EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# EMBEDDING_MODEL=qwen/qwen3-embedding-8b
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BATCH_SIZE=16
# EMBEDDING_TIMEOUT=120
# EMBEDDING_MAX_RETRIES=3
# RERANKER_PROVIDER=openai-rerank
# RERANKER_BASE_URL=https://openrouter.ai/api/v1
# RERANKER_MODEL=qwen/qwen3-reranker-8b
# RERANKER_TIMEOUT=30
# RERANKER_MAX_RETRIES=1

# --- Local stack (compose.models.yml, llama.cpp): the compose file sets these
# for the api container; for a natively running llama-server use host.docker.internal
# LLM_BASE_URL=http://llm:8080/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=qwen3.8-27b
# EMBEDDING_BASE_URL=http://embedder:8080/v1
# EMBEDDING_API_KEY=EMPTY
# EMBEDDING_MODEL=qwen3-embedding-8b
# RERANKER_BASE_URL=http://reranker:8080/v1
# RERANKER_API_KEY=EMPTY
# RERANKER_MODEL=qwen3-reranker-8b

# --- Reranker: rag-services gRPC (bge-reranker-v2-m3) or disabled ---
# RERANKER_PROVIDER=grpc
# RERANKER_SERVICE_URL=reranker-service:8352
# RERANKER_PROVIDER=none

# --- LLM: Anthropic (legacy branch) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-api-key
# ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_PROXY_URL=http://your-proxy:8080
# ANTHROPIC_PROXY_USER=proxyuser
# ANTHROPIC_PROXY_PASS=proxypassword

# ---------------------------------------------------------------------------
# Application settings with defaults, uncomment to override.
# ---------------------------------------------------------------------------
# MINIO_SECURE=true
# WEAVIATE_HOST=weaviate
# WEAVIATE_PORT=8080
# WEAVIATE_INSERT_BATCH_SIZE=100
# STARTUP_VERIFY_EMBEDDING_DIMENSION=true
# Chunking: CHUNK_* applies to PDF, MD_CHUNK_* to markdown
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# MD_CHUNK_SIZE=1800
# MD_CHUNK_OVERLAP=200
# MAX_FILE_SIZE_MB=50
# INITIAL_RETRIEVAL_K=20
# RERANK_TOP_K=5
# AGENT_CONFIDENCE_THRESHOLD=0.7
# Conversational sessions: /query with session_id remembers earlier turns
# SESSION_STORE=weaviate            # weaviate (persistent) | memory (tests, dry runs)
# SESSION_TTL_DAYS=7
# SESSION_HISTORY_MESSAGES=6        # verbatim tail given to the agent
# SESSION_SUMMARY_AFTER_MESSAGES=12 # older turns folded into a rolling LLM summary
# SESSION_MESSAGE_MAX_CHARS=1200    # per-message cap inside prompts
# SESSION_MAX_STORED_MESSAGES=200   # read cap per session
# SESSION_CLEANUP_INTERVAL_MINUTES=60   # 0 disables the periodic TTL sweep
