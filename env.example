# Docker image (set by CI/CD, can override for manual deploy)
IMAGE_TAG=ghcr.io/your-username/doc-arag:latest

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-api-key
ANTHROPIC_MODEL=claude-3-haiku-20240307
# Optional: Proxy for Anthropic API (if needed for your location)
# ANTHROPIC_PROXY_URL=http://your-proxy:8080
# ANTHROPIC_PROXY_USER=proxyuser
# ANTHROPIC_PROXY_PASS=proxypassword

# MinIO Configuration
MINIO_ROOT_USER=docarag-root-user
MINIO_ROOT_PASSWORD=your-secure-password-here
MINIO_BUCKET=default-documents

# Embedding Service (if external)
EMBEDDING_SERVICE_URL=embedding-service:8351

# Reranker Model
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
